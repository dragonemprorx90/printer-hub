# --- Required -----------------------------------------------------------
# Your printer's address on your network (shown in its network settings).
PRINTER_HOST=192.168.1.50
# Your relay (see docs/SETUP.md, "Relay"). Free on Cloudflare.
RELAY_URL=https://printer-hub-relay.YOUR-NAME.workers.dev

# --- Camera from away (optional) -----------------------------------------
# Creality K1 / K2: uncomment both lines (starts the go2rtc helper).
#COMPOSE_PROFILES=creality
#CAMERA_URL=http://127.0.0.1:1984/api/stream.mjpeg?src=cam_jpeg
# Snapmaker U1 / other Klipper cameras: the MJPEG stream instead, e.g.
#CAMERA_URL=http://192.168.1.50/webcam/?action=stream

# --- Slicing from the app (optional) -------------------------------------
# Add slicer to the profiles, e.g. COMPOSE_PROFILES=slicer or creality,slicer
# A second printer's bridge on the same machine needs its own port:
#SLICER_PORT=7071

# --- Failure detection (optional) ----------------------------------------
# Spots spaghetti on the camera (needs CAMERA_URL). Add detector to the
# profiles, e.g. COMPOSE_PROFILES=creality,detector. Pausing is set in the app.
#FAILURE_THRESHOLD=0.8      # higher = fewer false alarms, later alerts
#DETECTOR_URL=off           # this bridge ignores a detector on the machine

# --- Alerts and extras (optional) ----------------------------------------
#PRINTER_NAME=K2 Plus
#MOONRAKER_PORT=7125
#ALERTS=off                 # no phone notifications
#QUIET_HOURS=22-7           # no alerts at night
#HUMIDITY_LIMIT=45          # CFS humidity warning, %
#SPOOL_LOW_G=100            # low spool warning, grams
#BRIDGE_VERSION=latest      # or pin a release, e.g. 1.20.0
